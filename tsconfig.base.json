{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "ES2022",
    "moduleResolution": "node",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "baseUrl": ".",
    "paths": {
      "@omnitrace/domain": ["libs/domain/src/index.ts"],
      "@omnitrace/domain/*": ["libs/domain/src/*"],
      "@omnitrace/infrastructure": ["libs/infrastructure/src/index.ts"],
      "@omnitrace/infrastructure/*": ["libs/infrastructure/src/*"],
      "@omnitrace/ui-shared": ["libs/ui-shared/src/index.ts"],
      "@omnitrace/ui-shared/*": ["libs/ui-shared/src/*"]
    }
  }
}
